# Copy to .env for local runs. NEVER commit a filled-in .env.
# In production these are GitHub repo Settings -> Secrets and variables -> Actions.

# Required for email delivery. Create at https://resend.com/api-keys
# Use a SEND-ONLY restricted key, not a full-access key.
RESEND_API_KEY=

# Required. Where alerts are delivered.
NOTIFY_EMAIL=

# Optional. Sender address. Defaults to: Campground Crawler <onboarding@resend.dev>
# onboarding@resend.dev is Resend's shared TEST domain — alerts may land in spam.
# Set this to an address on a domain you have verified with Resend for reliable delivery.
NOTIFY_FROM=

# Optional. Raises RIDB rate limits AND is required for park-name -> facilityId
# resolution (RIDB returns HTTP 401 without it). Not needed if every watch in
# watches.json sets an explicit facilityId.
# Register at https://www.recreation.gov/manage-account/developer-api
RIDB_API_KEY=
